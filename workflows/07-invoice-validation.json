              "name": "Total",
              "value": "={{ Math.round(Number($('Find Pending Invoice').item.json.fields.Amount || 0) * (1 + (new Date($('Find Pending Invoice').item.json.fields.Created || $('Find Pending Invoice').item.json.createdTime || Date.now()) >= new Date('2025-01-01') ? 0.18 : 0.17)) * 100) / 100 }}",
              "type": "number"
            },
            {
              "id": "82e0c880-d054-438d-8ca3-8f8e4edc1999",
              "name": "InvoiceNumber",
              "value": "={{ 'INV-' + ((parseInt((($('Find Last Invoice Number').item.json.fields?.InvoiceNumber || 'INV-0000').split('-')[1])) || 0) + 1).toString().padStart(4, '0') }}",
              "type": "string"
            }
