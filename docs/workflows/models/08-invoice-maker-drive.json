    {
      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"he\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<title>חשבונית {{ $json.fields.InvoiceNumber }}</title>\n<style>\n  body{font-family:Arial,Helvetica,sans-serif;background:#f4f6f8;margin:0;padding:32px;color:#18212f}\n  .invoice{max-width:760px;margin:0 auto;background:#fff;border:1px solid #e1e6eb;border-radius:14px;padding:34px;box-shadow:0 10px 30px rgba(0,0,0,.06)}\n  .top{display:flex;justify-content:space-between;gap:24px;border-bottom:3px solid #111827;padding-bottom:20px;margin-bottom:28px}\n  .brand{font-size:25px;font-weight:700}\n  .brand small{display:block;font-size:12px;font-weight:400;color:#6b7280;margin-top:6px}\n  .meta{font-size:14px;line-height:1.9;text-align:left}\n  .badge{display:inline-block;background:#111827;color:white;padding:5px 10px;border-radius:999px;font-size:12px}\n  .customer{background:#f8fafc;border:1px solid #e5e7eb;border-radius:10px;padding:14px 16px;margin-bottom:24px}\n  table{width:100%;border-collapse:collapse;margin-top:10px}\n  th,td{border-bottom:1px solid #e5e7eb;padding:13px 10px;text-align:right}\n  th{background:#f8fafc;font-size:13px}\n  .sum{margin-top:22px;margin-right:auto;width:320px}\n  .sum-row{display:flex;justify-content:space-between;padding:8px 0}\n  .sum-row.total{font-size:18px;font-weight:700;border-top:2px solid #111827;margin-top:6px;padding-top:12px}\n  .foot{margin-top:30px;font-size:12px;color:#6b7280;border-top:1px solid #e5e7eb;padding-top:14px}\n</style>\n</head>\n<body>\n<div class=\"invoice\">\n  <div class=\"top\">\n    <div>\n      <div class=\"brand\">Kobi Smart Electronics\n        <small>מערכת ERP חכמה · פרויקט לימודי</small>\n      </div>\n      <div style=\"margin-top:12px\"><span class=\"badge\">חשבונית מס · דמו</span></div>\n    </div>\n    <div class=\"meta\">\n      <div><b>מספר:</b> {{ $json.fields.InvoiceNumber }}</div>\n      <div><b>תאריך:</b> {{ $now.format('dd/MM/yyyy') }}</div>\n      <div><b>סטטוס:</b> {{ $json.fields.Status }}</div>\n    </div>\n  </div>\n\n  <div class=\"customer\">\n    <b>לקוח:</b> {{ $json.fields.CustomerId }}\n  </div>\n\n  <table>\n    <tr>\n      <th>תיאור</th>\n      <th>סכום לפני מע\"מ</th>\n      <th>מע\"מ</th>\n      <th>סה\"כ</th>\n    </tr>\n    <tr>\n      <td>מוצרי אלקטרוניקה / עסקה</td>\n      <td>{{ $json.fields.Amount }} ₪</td>\n      <td>{{ $json.fields.VatAmount }} ₪</td>\n      <td>{{ $json.fields.Total }} ₪</td>\n    </tr>\n  </table>\n\n  <div class=\"sum\">\n    <div class=\"sum-row\"><span>לפני מע\"מ</span><span>{{ $json.fields.Amount }} ₪</span></div>\n    <div class=\"sum-row\"><span>מע\"מ</span><span>{{ $json.fields.VatAmount }} ₪</span></div>\n    <div class=\"sum-row total\"><span>סה\"כ לתשלום</span><span>{{ $json.fields.Total }} ₪</span></div>\n  </div>\n\n  <div class=\"foot\">\n    מסמך זה הופק אוטומטית על-ידי Kobi ERP לצורכי פרויקט לימודי.\n  </div>\n</div>\n</body>\n</html>"
      },
