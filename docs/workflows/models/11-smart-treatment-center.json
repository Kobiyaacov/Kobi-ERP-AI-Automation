      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "556efe5d-42ba-4fac-9ef0-5d2051a17e54",
              "name": "kind",
              "value": "={{ $json.fields?.Title !== undefined ? 'task_open' : (($json.fields?.Name !== undefined || $json.fields?.Email !== undefined) ? 'lead_replied' : ($json.fields?.Status === 'Invalid' ? 'invoice_invalid' : 'invoice_ready')) }}",
              "type": "string"
            },
            {
              "id": "49ae829d-b8ae-47b3-a7a1-90bbb6eb1fc4",
              "name": "recordId",
              "value": "={{ $json.id }}",
              "type": "string"
            },
            {
              "id": "e58651e2-f016-44e2-b243-2464aefadc00",
              "name": "priority",
              "value": "={{ ($json.fields?.Status === 'Invalid' || $json.fields?.Status === 'Replied') ? 'גבוהה' : 'בינונית' }}",
              "type": "string"
            },
            {
              "id": "419c91a5-200d-4e97-a143-56528aa727c3",
              "name": "title",
              "value": "={{ $json.fields?.Title !== undefined ? 'משימה פתוחה: ' + ($json.fields.Title || 'ללא כותרת') : (($json.fields?.Name !== undefined || $json.fields?.Email !== undefined) ? 'ליד חזר: ' + ($json.fields.Name || $json.fields.Email || 'ליד ללא שם') : ($json.fields?.Status === 'Invalid' ? 'חשבונית דורשת בדיקה: ' + ($json.fields.InvoiceNumber || $json.id) : 'חשבונית ממתינה להפקת מסמך: ' + ($json.fields.InvoiceNumber || $json.id))) }}",
              "type": "string"
            },
            {
              "id": "cbbaff35-3858-4ce5-b22f-9ff343e8952d",
              "name": "reason",
              "value": "={{ $json.fields?.Title !== undefined ? 'המשימה עדיין פתוחה.' : (($json.fields?.Name !== undefined || $json.fields?.Email !== undefined) ? 'התקבלה תגובה מהליד. מומלץ לחזור אליו.' : ($json.fields?.Status === 'Invalid' ? 'נתוני החשבונית לא עברו את בדיקת התקינות.' : 'החשבונית מוכנה אך עדיין אין לה קישור למסמך.')) }}",
              "type": "string"
            },
            {
              "id": "60b58a18-5097-4635-98eb-d47316c7db33",
              "name": "recommendedAction",
              "value": "={{ $json.fields?.Title !== undefined ? 'פתח את המשימה וטפל בה.' : (($json.fields?.Name !== undefined || $json.fields?.Email !== undefined) ? 'פתח את הליד או צור משימת טיפול.' : ($json.fields?.Status === 'Invalid' ? 'פתח את החשבונית ובדוק CustomerId ו-Amount.' : 'בדוק את Flow 8 או הרץ את הפקת המסמך.')) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
